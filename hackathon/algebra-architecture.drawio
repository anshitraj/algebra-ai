<mxfile host="app.diagrams.net"><diagram id="algebra-architecture" name="Algebra architecture"><mxGraphModel dx="1600" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:28px&quot;&gt;Algebra · architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#5F5E5A&quot;&gt;The router and spend firewall for AI agents that pay for APIs on Solana&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="900" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:17px;color:#085041&quot;&gt;Algebra backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F5E5A&quot;&gt;Go · one process · REST and MCP call the same services&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FCF9;strokeColor=#1D9E75;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="570" y="130" width="560" height="565" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:17px;color:#0C447C&quot;&gt;Discovery&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F5E5A&quot;&gt;1,622 providers in 4 catalogs, plus the open web&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6FAFE;strokeColor=#378ADD;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1170" y="130" width="390" height="270" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:17px;color:#712B13&quot;&gt;Solana&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#5F5E5A&quot;&gt;USDC · mainnet and devnet kept apart&lt;/span&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8F5;strokeColor=#D85A30;dashed=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="570" y="745" width="990" height="235" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:17px&quot;&gt;One paid request&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Agent asks: work, input, max price (REST or MCP)&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Spend firewall checks the pass: allow, ask you, deny&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; Router gathers candidates: catalogs by class, web&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; Free 402 quotes; guards drop bad ones; rank&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; Coordinator reserves one attempt (never twice)&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; On-chain pass: program pulls exact amount&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Rail pays the provider in USDC; provider answers&lt;br&gt;&lt;b&gt;8&lt;/b&gt;&amp;nbsp; Settlement proven from chain; signed receipt back" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAFAF8;strokeColor=#B4B2A9;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="490" height="235" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:15px;color:#3C3489&quot;&gt;You (the person)&lt;/b&gt;&lt;br&gt;Sign in with Privy&lt;br&gt;(Solana wallet or email code)&lt;br&gt;Create Spend Passes&lt;br&gt;Approve · freeze · kill switch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:15px;color:#3C3489&quot;&gt;AI agents&lt;/b&gt;&lt;br&gt;Claude Code · Cursor&lt;br&gt;ChatGPT agents · any bot&lt;br&gt;Algebra console chat&lt;br&gt;Hold a Spend Pass token,&lt;br&gt;never a wallet key" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="240" height="170" as="geometry"/></mxCell><mxCell id="c9" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="248" y="328" width="24" height="22" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:15px;color:#3C3489&quot;&gt;Owner's Solana wallet&lt;/b&gt;&lt;br&gt;Phantom · Solflare · Backpack&lt;br&gt;Funds the pass vault&lt;br&gt;Freezes it on chain" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:15px;color:#444441&quot;&gt;Web console&lt;/b&gt;&lt;br&gt;Next.js&lt;br&gt;Passes · firewall · routing&lt;br&gt;Providers · executions&lt;br&gt;Agent chat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="215" height="130" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:15px;color:#444441&quot;&gt;REST API&lt;/b&gt;&lt;br&gt;/api/v1/execute · simulate" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="215" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:15px;color:#444441&quot;&gt;MCP server&lt;/b&gt;&lt;br&gt;/mcp · 7 tools" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="215" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:15px;color:#085041&quot;&gt;Spend firewall&lt;/b&gt;&lt;br&gt;A Spend Pass per agent&lt;br&gt;Budget · per-call cap&lt;br&gt;Approval line · allow-list&lt;br&gt;Calls per minute&lt;br&gt;Rule for never-paid providers&lt;br&gt;Kill switch · dry run" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="590" y="190" width="255" height="170" as="geometry"/></mxCell><mxCell id="c15" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="813" y="198" width="24" height="22" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:15px;color:#085041&quot;&gt;Router&lt;/b&gt;&lt;br&gt;14 classes of work&lt;br&gt;Free unpaid 402 quotes&lt;br&gt;Guards drop down, overpriced&lt;br&gt;and trap-priced providers&lt;br&gt;Rank: cheapest · fastest · auto&lt;br&gt;Falls back if nothing was paid" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="860" y="190" width="255" height="170" as="geometry"/></mxCell><mxCell id="c17" value="3 4" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1067" y="198" width="40" height="22" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;font-size:15px;color:#085041&quot;&gt;Economic coordinator&lt;/b&gt;&lt;br&gt;intent → reserve → begin → authorize → complete → reconcile&lt;br&gt;One live attempt per outcome, enforced by Postgres: never pays twice" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="590" y="375" width="525" height="95" as="geometry"/></mxCell><mxCell id="c19" value="5" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1083" y="383" width="24" height="22" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:15px;color:#085041&quot;&gt;Receipts and replay&lt;/b&gt;&lt;br&gt;Ed25519-signed receipt&lt;br&gt;Anyone verifies: /verify, JWKS&lt;br&gt;Answer kept sealed for 24 h" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="590" y="485" width="255" height="105" as="geometry"/></mxCell><mxCell id="c21" value="8" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="813" y="493" width="24" height="22" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:15px;color:#444441&quot;&gt;PostgreSQL · Redis&lt;/b&gt;&lt;br&gt;Postgres is the source of truth&lt;br&gt;Redis: rate limits only" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="590" y="605" width="255" height="75" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&quot;font-size:15px;color:#712B13&quot;&gt;Payment rails&lt;/b&gt;&lt;br&gt;x402 exact (USDC)&lt;br&gt;x402 upto (metered)&lt;br&gt;Jupiter swap (off by default)&lt;br&gt;Sandbox (demo, no real money)&lt;br&gt;Ceiling: 1 USDC a payment&lt;br&gt;The key never leaves the rail" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="860" y="485" width="255" height="195" as="geometry"/></mxCell><mxCell id="c24" value="6 7" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1067" y="493" width="40" height="22" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;color:#0C447C&quot;&gt;Pay.sh · 75 providers&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;align=left;spacingLeft=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1190" y="192" width="350" height="32" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&quot;color:#0C447C&quot;&gt;Circle Agent Marketplace · 27&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;align=left;spacingLeft=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1190" y="230" width="350" height="32" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;color:#0C447C&quot;&gt;PayAI bazaar · 1,152&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;align=left;spacingLeft=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1190" y="268" width="350" height="32" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;color:#0C447C&quot;&gt;Coinbase x402 Bazaar · 368&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;align=left;spacingLeft=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1190" y="306" width="350" height="32" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;color:#0C447C&quot;&gt;Gemini web search · unlisted APIs&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#185FA5;align=left;spacingLeft=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1190" y="344" width="350" height="32" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b style=&quot;font-size:15px;color:#0C447C&quot;&gt;Paid API providers (x402)&lt;/b&gt;&lt;br&gt;Token price · token risk · search · LLM …&lt;br&gt;Ask: HTTP 402 with a price&lt;br&gt;Pay: a signed USDC transfer&lt;br&gt;Answer: treated as untrusted data" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E6F1FB;strokeColor=#185FA5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="1170" y="430" width="390" height="165" as="geometry"/></mxCell><mxCell id="c31" value="4 7" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1512" y="438" width="40" height="22" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b style=&quot;font-size:15px;color:#712B13&quot;&gt;Spend Pass program (Anchor)&lt;/b&gt;&lt;br&gt;devnet · 46gQ…9tdS&lt;br&gt;A vault per pass, owner-funded&lt;br&gt;Limits checked on chain&lt;br&gt;Pulls the exact amount first&lt;br&gt;Unused pulls refunded" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="590" y="795" width="310" height="165" as="geometry"/></mxCell><mxCell id="c33" value="6" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="868" y="803" width="24" height="22" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style=&quot;font-size:15px;color:#712B13&quot;&gt;Algebra's payer wallets&lt;/b&gt;&lt;br&gt;One per cluster&lt;br&gt;Sign x402 USDC transfers&lt;br&gt;Facilitator settles them&lt;br&gt;Settlement proven from chain" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2C2C2A;" vertex="1" parent="1"><mxGeometry x="920" y="795" width="300" height="165" as="geometry"/></mxCell><mxCell id="c35" value="7 8" style="rounded=1;arcSize=50;html=1;fillColor=#2C2C2A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1172" y="803" width="40" height="22" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b style=&quot;font-size:15px;color:#712B13&quot;&gt;Other Solana programs&lt;/b&gt;&lt;br&gt;Payment channels (x402 upto):&lt;br&gt;escrow, settle, refund&lt;br&gt;Jupiter: token swaps&lt;br&gt;SPL Token: USDC" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FAECE7;strokeColor=#993C1D;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=13;fontFamily=Segoe UI;fontColor=#2