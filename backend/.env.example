# Copy to .env and fill in for local development. Never commit a real .env.

# --- Postgres (authoritative commerce state) ---
# Matches docker-compose.yml's default credentials.
DATABASE_URL=postgres://algebra:algebra@localhost:5432/algebra?sslmode=disable

# --- Redis (cache / locks / idempotency fast-path; not authoritative) ---
REDIS_ADDR=localhost:6379

# --- Local state ---
# Where wallet key files and linked merchant sessions are kept. Default: .data in the
# working directory. The make targets and scripts/dev-native.ps1 point it at the
# repository's .data; a deployment points it at a persistent volume.
# ALGEBRA_DATA_DIR=../.data

# --- Envelope encryption for PrivacyResolver (internal/domain/privacy) ---
# 32 random bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
# In production this should be a KMS-wrapped DEK, not a static env var —
# see ../docs/GCP_DEPLOYMENT.md. This is a LOCAL-DEV-ONLY secret.
ALGEBRA_MASTER_KEY=

# --- REST API ---
HTTP_ADDR=:8080
# Exact-match allow-list for browser callers (the frontend/ Next.js console).
# Comma-separated; the CORS spec forbids "*" alongside credentialed headers
# like Authorization, so list real origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Environment ---
# production turns on fail-fast checks at startup (config.ValidateProduction):
# https PUBLIC_WEB_URL, Redis, Resend, no mock store, no dev auth, TLS to
# Postgres. See ../docs/PRODUCTION.md.
APP_ENV=development
# ALLOW_MOCK_MERCHANT=true   # staging only: keep the test store with APP_ENV=production

# --- Web search: real product listings across Indian stores ---
# Gemini with Google Search grounding (connectors/websearch.Gemini). Same key
# the web app's agent uses. GOOGLE_GEMINI_API is accepted as an alias. With a
# key, agents can also search the open web for pay-per-call endpoints no catalog
# lists (algebra_discover_web, POST /api/v1/discover/web): a few searches an
# hour per agent, every find asked what it charges with a free request before
# it is offered, none of them trusted.
# GEMINI_API_KEY=
# GEMINI_SEARCH_MODEL=gemini-flash-latest
# How long a web-search result is reused (Redis). Grounded searches are
# billed per request, so repeats within this window are free and instant.
WEB_SEARCH_CACHE_TTL=10m
# Not needed: Google's Retail / AI Commerce Search and Discovery Engine APIs
# search YOUR OWN uploaded catalog, not other retailers — see ../docs/PRODUCTION.md.

# --- Billing for Algebra's own plans (Razorpay) ---
# Keys from dashboard.razorpay.com → Settings → API Keys (rzp_test_... first).
# Without them everyone stays on the free Developer plan (100 orders/month).
# Webhook: add https://<PUBLIC_WEB_URL>/api/v1/billing/webhooks/razorpay with
# the subscription.* events and set its secret below.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_GROWTH=          # use a plan made in the dashboard, or leave empty…
# GROWTH_PRICE_INR=8499           # …and one is created at this monthly price on first checkout
# ALLOW_TEST_PAYMENTS=true        # staging only: permit rzp_test_ keys with APP_ENV=production

# --- Accounts: sign-in for the web app (internal/api/v1/auth.go) ---
# The origin people reach the web app at. The web app proxies /api/v1 to this
# API (frontend/next.config.ts), so session cookies are first-party. OAuth redirect
# URIs and password-reset links are built from it; https:// also makes the
# session cookie Secure.
PUBLIC_WEB_URL=http://localhost:3000
SESSION_TTL=720h
# The console no longer shows Google or GitHub buttons (the sign-in is an emailed
# code); the API's OAuth endpoints below still work if you set these and link to
# them yourself.
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth
# client (Web application). Authorized redirect URI:
#   <PUBLIC_WEB_URL>/api/v1/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → New OAuth App. Callback URL:
#   <PUBLIC_WEB_URL>/api/v1/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Sign-in is a six-digit code emailed to the person: type the address, type the
# code. The first sign-in makes the account; the same address is the same account
# afterwards, including one made earlier with a password. A code is good for ten
# minutes and five tries (a fifth wrong one burns it), one is sent at most every
# 30 seconds and six an hour to an address, and only a keyed hash of it is stored.
# It needs RESEND_API_KEY below: without one the code is printed to this API's
# log, which is fine locally and never in production. EMAIL_CODE_LOGIN=off closes it.
# EMAIL_CODE_LOGIN=on
# Email via Resend (resend.com): password resets, an alert after each
# sign-in, the receipt of each payment that lands on a chain (with its PDF
# attached), and the link that confirms an address someone adds for their
# notifications. Without a key, every email is printed to this API's log
# instead: fine locally, never in production. EMAIL_FROM must be a sender on
# a domain verified in Resend, exactly as verified: a subdomain such as
# auth.example.com means a sender like no-reply@auth.example.com. To try it
# before you have one, "Algebra <onboarding@resend.dev>" delivers to your own
# Resend address only. Emails are sent as HTML with the plain text beside it;
# the mark at the top is served by the web app at /email/algebra-mark.png.
# RESEND_API_KEY=
# EMAIL_FROM=Algebra <no-reply@yourdomain.com>
# Re-enables the pre-accounts dev shortcuts (X-User-ID header as identity,
# unauthenticated POST /users and /agents). Lets anyone act as anyone —
# local scripts only, never on a reachable host.
# ALGEBRA_DEV_AUTH=true
# Two ways into the app, both on the sign-in page:
#  - Demo: one click, no signup. A demo account pays in the sandbox only:
#    simulated providers and USDC, no wallet, nothing on a chain. The API
#    enforces it, so a demo account can never reach a real rail, whatever its
#    agent asks for. It needs ECONOMIC_SANDBOX=on (below; on by default outside
#    production) or it has nothing to pay. Set DEMO_ACCOUNTS=off to hide it.
#  - A real account, through the emailed code (above). Email and password stay
#    as a second way in, behind a link on the page, while PASSWORD_LOGIN is on;
#    PASSWORD_LOGIN=off closes those endpoints and the link.
# DEMO_ACCOUNTS=on
# Spend Passes: where agents reach this deployment's MCP server (cmd/mcp -http,
# behind TLS). Shown to people connecting Claude Code, Cursor or an OpenAI
# agent with a pass; unset hides the MCP option (the REST API still works).
# MCP_PUBLIC_URL=https://mcp.yourdomain.com
# The MCP server offers the execution tools by default (algebra_discover,
# algebra_quote, algebra_simulate, algebra_execute, algebra_status,
# algebra_receipt, algebra_spend_pass, algebra_classes, algebra_discover_web).
# "on" also offers the original shopping product's tools (commerce.*,
# payments.*, profiles.*, policy.*) and the earlier names
# algebra.discover_providers and algebra.execution_status. Those keep their
# dots, which Codex, Cursor and other clients may refuse: leave it off for them.
# MCP_LEGACY_TOOLS=off
# PASSWORD_LOGIN=on

# --- Plugins (console → Plugins) ---
# Community deal plugins (Reddit subreddits each person picks, DesiDime) read
# through Gemini's Google search by default. With a Tavily key they read
# through Tavily instead, which can limit results to the last week — better
# for deals that expire within hours. Deal plugins (Amazon, Flipkart, bank
# offers) show "needs setup" until their keys / BANK_OFFERS_FILE are set.
# TAVILY_API_KEY=

# --- Abuse and cost limits (need Redis; 0 turns a cap off) ---
# Every agent message is an LLM call plus billed web searches.
# AGENT_TURNS_PER_DAY=200           # per person, per day
# DEMO_AGENT_TURNS_PER_DAY=40       # per no-signup demo account
# DEMO_ACCOUNTS_PER_IP_PER_DAY=5    # demo accounts one address can open a day
# How many X-Forwarded-For entries, from the right, your own load balancers
# wrote (the web app's rewrite passes the header through unchanged). Per-IP
# limits key on that entry; anything left of it is client-supplied.
#   1 = one load balancer that appends the client address (default)
#   2 = Google Cloud's HTTPS load balancer (appends client + its own address)
# TRUSTED_PROXY_HOPS=1
# When the web app (Vercel, say) proxies to this API, the API only ever sees the
# web host's address, so every visitor would share one per-IP budget (sign-ins,
# demo accounts, anonymous reads). Set the same secret here and as
# ALGEBRA_EDGE_SECRET on the web app: its proxy then sends the visitor's address
# (Vercel's own, which a visitor can't choose) and the API trusts it only with
# that secret. At least 32 characters: openssl rand -hex 32
# EDGE_SHARED_SECRET=

# --- Devnet faucet (optional) ---
# A funded devnet wallet that tops up a signed-in person's own wallet with devnet
# SOL and USDC (Quickstart: "Get test funds"), so nobody copies addresses to a
# public faucet. Use a wallet that holds devnet tokens only, never one that has
# held real money, and keep its key in the host's secret store, not in a file in
# the repository. Devnet only: the server turns it off on any other cluster.
# Fund the wallet with SOL (faucet.solana.com) and USDC (faucet.circle.com).
# Each account gets ONE airdrop in its lifetime, and each wallet one: the
# database remembers (table devnet_faucet_drops, migration 0027), so a restart
# or a second server cannot give it again, and erasing an account does not
# make it available again.
# DEVNET_FAUCET_KEYPAIR=            # JSON array or base58, or:
# DEVNET_FAUCET_KEYPAIR_FILE=
# DEVNET_FAUCET_SOL=0.2             # per drop
# DEVNET_FAUCET_USDC=2              # per drop
# DEVNET_FAUCET_PER_DAY=200         # drops a day, for everyone (and at most 5 a day per network address)
# DEVNET_FAUCET_RPC_URL=

# --- Operator ---
# The operator's own key, sent as the X-Algebra-Operator-Token header. Set it on
# any server that takes customers: it is the only way to read Book a Demo
# enquiries (GET /api/v1/leads), to verify, block or unblock a provider
# (PUT /api/v1/intel/endpoints/{id}/trust), to refresh the provider registry on
# demand (POST /api/v1/intel/refresh), and to register B2B tenants and
# integrators. Unset: all of that is open in development and closed to everyone
# in production (the API logs a warning at startup). At least 32 characters.
# openssl rand -hex 32
# ALGEBRA_OPERATOR_TOKEN=
# Email each new Book a Demo enquiry here (needs RESEND_API_KEY; without it the
# email is written to the log). Unset: enquiries are only stored.
# LEADS_NOTIFY_EMAIL=sales@example.com
# Web-tool keys the operator keeps for the operator's own accounts
# (docs/SPEND_PASSES.md). A key here is the operator's own account with the
# vendor, billed there for every call, so it is offered only to the accounts at
# the addresses in ALGEBRA_OPERATOR_EMAILS (comma separated; they sign in with an
# emailed code and have no password) and to nobody else. A key a person
# saves themselves under Account > Web tools wins over it. Keys with no address
# listed: no account can use them, and the API logs a warning.
# ALGEBRA_OPERATOR_EMAILS=you@example.com
# TINY_FISH_API=
# EXA_API=
# FIRECRAWL_API=
# TAVILY_API=

# --- Policy engine ---
# internal/domain/policy.LocalProvider is the sole PolicyProvider — a real,
# deterministic Go rule engine (rules.go) for both ordinary merchant/INR
# purchases and crypto-rail payments (Input.CryptoRecipient/AmountUSDC).
# Fully in-process: nothing to configure here, no external server to run.
# Its ruleset is code-configured (policy.DefaultRules(), same as
# AllowedMerchants/BlockedCategories below); edit that function to change
# limits, allow/block-lists, or the crypto-rail fields
# (AllowedCryptoRecipients/MaxCryptoTxUSDC/CryptoConfirmThresholdUSDC).

# --- Approval / quote tuning ---
APPROVAL_TTL=15m
QUOTE_TTL=5m
QUOTE_AMOUNT_TOLERANCE_MINOR_UNITS=500

# --- Webhooks (real endpoint + HMAC verification, no real provider wired
#     up yet — see ../docs/THREAT_MODEL.md and internal/app/webhook_service.go) ---
# Every inbound POST /api/v1/webhooks/{provider} is REJECTED unless the
# matching secret below is set. Uncomment and fill in only once a real
# provider (a PSP, a merchant) actually sends webhooks here, using
# WHATEVER signature scheme that specific provider uses — the generic
# "sha256=<hmac-hex>" scheme this build implements is a reference default,
# not guaranteed to match a real provider's own format.
# WEBHOOK_SECRET_STRIPE=
# WEBHOOK_SECRET_ZEPTO=

# --- Merchant connectors: the original shopping product (../docs/legacy/MERCHANT_CONNECTORS.md) ---
# Connectors to register. swiggy_instamart is opt-in: Swiggy reviews
# production access to its MCP servers (builders@swiggy.in).
# ENABLED_MERCHANTS=none registers no connector: an API-only deployment, which in
# production must not have the mock test store either.
ENABLED_MERCHANTS=mock,zepto,amazon,flipkart,blinkit,generic-browser
# Encrypted linked-account sessions written by cmd/merchant-login.
# Linked merchant sessions go in merchant-sessions under ALGEBRA_DATA_DIR unless this says otherwise.
# MERCHANT_SESSION_DIR=../.data/merchant-sessions
# Per-merchant budget for discovery (search + cart + quote round trips).
CONNECTOR_TIMEOUT=20s
# Product and handoff links an agent may be given must be on these domains.
MERCHANT_URL_ALLOWLIST=zepto.co.in,zeptonow.com,swiggy.com,amazon.in,flipkart.com,blinkit.com

# Zepto / Swiggy Instamart — official remote MCP servers. No keys go here:
# link an account with `go run ./cmd/merchant-login -merchant zepto` (or
# `-merchant swiggy_instamart -alias shipping:home`). You sign in with your
# phone number and OTP on the merchant's own page; Algebra stores only the
# resulting OAuth tokens, encrypted with ALGEBRA_MASTER_KEY.
ZEPTO_MCP_ENDPOINT=https://mcp.zepto.co.in/mcp
SWIGGY_INSTAMART_MCP_ENDPOINT=https://mcp.swiggy.com/im

# Flipkart — official Affiliate API (catalog search only; no cart/order API exists).
# FLIPKART_AFFILIATE_ID=
# FLIPKART_AFFILIATE_TOKEN=

# Amazon — official Creators API (catalog search only; no cart/order API
# exists). www.amazon.in uses credential version 3.2 (or legacy 2.2).
# AMAZON_CREATORS_CREDENTIAL_ID=
# AMAZON_CREATORS_CREDENTIAL_SECRET=
# AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
# AMAZON_ASSOCIATE_TAG=
# AMAZON_MARKETPLACE=www.amazon.in

# Bank/card offers shown by commerce.find_deals next to Amazon/Flipkart deals.
# Neither store publishes these through an API, so they're curated by hand
# from the stores' offer pages — see internal/platform/bankoffers/testdata/bank-offers.example.json. Every
# offer needs ends_at and a terms_url on the store's own domain.
# BANK_OFFERS_FILE=../.data/bank-offers.json

# Blinkit — no official API or MCP server exists; handoff links only, nothing to set.

# General web-search fallback (commerce.web_search) — used only when no
# connected merchant connector can find a product. Backed by Google's
# Programmable Search Engine / Custom Search JSON API. Get an API key from
# Google Cloud Console and create a search engine (set to search the whole
# web) at https://programmablesearchengine.google.com/ for its "cx" ID.
# Neither an existing merchant connector, nor cart/checkout/order — links only.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# --- Economic execution (../docs/ECONOMIC_COORDINATION.md) ---
# Algebra pays for machine-payable APIs on an agent's behalf (x402) and
# returns the result with a signed receipt.
#
# ECONOMIC_SANDBOX=on mounts a SIMULATED rail and simulated x402 providers
# (no real money, everything labelled test). On by default outside
# production. Demo accounts pay here and nowhere else, so turn it on wherever
# DEMO_ACCOUNTS is on. Execution through the sandbox only works in the API
# process, because the simulated rail's ledger lives in that process's memory.
# ECONOMIC_SANDBOX=on
#
# Providers you pin by hand (trusted as native; agents name them by
# "provider"). A mistake here stops startup rather than dropping a provider.
# Each needs a rail for its network; until a real rail is configured only
# "network":"sandbox" providers can actually be paid.
# ECONOMIC_PROVIDERS=[{"capability":"solana.token-risk","provider":"acme","endpoint":"https://api.acme.example/risk","method":"POST","network":"solana"}]

# Solana USDC rail: Algebra pays x402 providers from a wallet it controls.
# Off unless SOLANA_CLUSTER is set. Create a devnet wallet with
#   go run ./cmd/solana-wallet -new -out ../.data/solana-devnet.json
# then check it with `go run ./cmd/solana-wallet`, and check any provider
# with `go run ./cmd/x402-dryrun -url ...` (it sends nothing) before use.
# SOLANA_CLUSTER=devnet
# SOLANA_RPC_URL=                       # empty: the public endpoint for the cluster
# SOLANA_KEYPAIR_FILE=../.data/solana-devnet.json   # preferred over SOLANA_KEYPAIR
# SOLANA_MAX_PAYMENT_USDC=1             # hard ceiling per payment, enforced in the rail
# mainnet moves REAL money and needs an explicit yes:
# SOLANA_CLUSTER=mainnet
# SOLANA_ALLOW_MAINNET=yes
#
# Devnet AND mainnet at once (the console's network switch pays on whichever
# is picked; each payment is restricted to that cluster). One wallet each;
# SOLANA_MAX_PAYMENT_USDC applies to both. Don't also set SOLANA_CLUSTER for
# a cluster configured here.
# SOLANA_DEVNET_KEYPAIR_FILE=../.data/solana-devnet.json
# SOLANA_DEVNET_RPC_URL=
# Or, on devnet only, let Algebra make the payer key itself: it is kept sealed in
# the database (under ALGEBRA_MASTER_KEY: back that up) and asks the faucet for SOL.
# Not with a wallet above, and refused on mainnet. Pin the address it logs so a
# lost database can never swap it silently. See ../docs/SIGNER.md.
# SOLANA_DEVNET_SIGNER=generated
# SOLANA_DEVNET_SIGNER_PUBKEY=
# Real money: the payer is a Cloud KMS Ed25519 key, one exact version. Required for
# mainnet with APP_ENV=production. Not with a wallet above. See ../docs/SIGNER.md.
# SOLANA_MAINNET_KMS_KEY_VERSION=projects/PROJECT/locations/REGION/keyRings/algebra/cryptoKeys/solana-payer/cryptoKeyVersions/1
# SOLANA_MAINNET_SIGNER_PUBKEY=
# Credentials for KMS off Google Cloud: a file, or (single-container image) the JSON itself.
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CREDENTIALS_JSON=
# SOLANA_MAINNET_KEYPAIR_FILE=../.data/solana-mainnet.json
# SOLANA_MAINNET_RPC_URL=
# SOLANA_ALLOW_MAINNET=yes
#
# A configured mainnet wallet is still read-only: discovery, quotes and dry
# runs work, and every mainnet payment is refused (MAINNET_EXECUTION_DISABLED)
# until this is "on". "on" is refused at startup unless ONCHAIN_PASSES=on and
# SPEND_PASS_REQUIRED includes mainnet, and while the program's upgrade authority
# on mainnet is this server's own payer key. GET /api/v1/mainnet/readiness lists every gate.
# See ../docs/MAINNET_READINESS.md before turning it on.
# MAINNET_EXECUTION=off

# The test-money guard. A devnet payment is test money from the wallet above, so
# there is no vault behind a person's payment; what stops one account, or all of
# them together, from emptying the wallet is a count: each account makes up to
# TEST_MONEY_PER_ACCOUNT_PER_DAY payments in 24 hours and the server up to
# TEST_MONEY_PER_DAY, each at most SOLANA_MAX_PAYMENT_USDC. On by default. The
# counts live in Redis when there is one (shared by every instance), in memory
# otherwise. APP_ENV=production refuses TEST_MONEY_GUARD=off unless every
# payment comes from a vault (below).
# TEST_MONEY_GUARD=on
# TEST_MONEY_PER_ACCOUNT_PER_DAY=25
# TEST_MONEY_PER_DAY=400

# Spend Passes enforced on Solana (../docs/SPEND_PASS_PROGRAM.md): a vault per
# pass, kept by Algebra's program. OFF unless ONCHAIN_PASSES=on; then it runs
# wherever a Solana rail does and the program is deployed on its cluster. The
# rail's payer is every pass's agent, so it needs a little SOL for pull and
# refund fees. Without it none of the SPEND_PASS_* settings below do anything.
# ONCHAIN_PASSES=on
# SPEND_PASS_PROGRAM_ID=                  # where new passes are made; empty: the Anchor program; off: disable
# SPEND_PASS_REQUIRED=mainnet             # here a pass must be on chain to pay at all (mainnet always needs it)
# SPEND_PASS_ANY_OWNER=devnet             # owner needn't be a sign-in wallet (demos); never mainnet
# SPEND_PASS_PRIORITY_MICROLAMPORTS=10000
# A usage-based (x402 upto) payment whose seller never settles its payment channel
# leaves the ceiling escrowed. The payer takes the program's way out (close, seal,
# withdraw) once an attempt is this long past its deadline, and the vault is
# refunded. See ../docs/PAYMENT_CHANNELS.md.
# CHANNEL_RECOVERY_AFTER=10m

# Spend Passes enforced on Solana (../docs/SPEND_PASS_PROGRAM.md): on wherever a
# Solana rail runs and the program is deployed on its cluster. The rail's payer
# is every pass's agent, so it needs a little SOL for pull and refund fees.
# SPEND_PASS_PROGRAM_ID=                  # where new passes are made; empty: the Pinocchio program; off: disable
# SPEND_PASS_REQUIRED=mainnet             # here a pass must be on chain to pay at all (set it in production)
# SPEND_PASS_ANY_OWNER=devnet             # owner needn't be a sign-in wallet (demos); never mainnet
# SPEND_PASS_PRIORITY_MICROLAMPORTS=10000

# Provider catalogs agents can browse and name (../docs/EXECUTION.md):
# Pay.sh, Circle's Agent Marketplace, PayAI's x402 bazaar and Coinbase's CDP
# Bazaar. All are on by default; each is read through the SSRF-safe client and
# cached. Devnet-payable providers come from PayAI today. Coinbase's lists
# 35,000 endpoints from every chain and ignores the network filter, so the
# first five pages (the most used, about 15 MB) are read at most twice an hour;
# turn it off if that's more than you want to fetch.
# PAYSH_ENABLED=off
# PAYSH_CATALOG_URL=https://pay.sh/api/catalog
# PAYSH_DOCS_URL=https://pay.sh/api
# CIRCLE_AGENTS_ENABLED=off
# CIRCLE_DISCOVERY_URL=https://api.circle.com/v2/x402/discovery/resources
# PAYAI_ENABLED=off
# PAYAI_DISCOVERY_URL=https://facilitator.payai.network/discovery/resources
# CDP_BAZAAR_ENABLED=off
# CDP_DISCOVERY_URL=https://api.cdp.coinbase.com/platform/v2/x402/discovery/resources
# Monid's tools (24 providers, 624 endpoints), from a snapshot of its
# open-source connectors built into the binary: nothing is fetched. Listed for
# comparison only; Monid bills from its own prepaid balance, not x402, so none
# is payable through Algebra. Refresh with cmd/monid-import (see its header).
# MONID_CATALOG=off

# Buy tokens with USDC through Jupiter (capability solana.swap). OFF unless turned
# on, because it moves value: it spends USDC from the Solana MAINNET wallet above
# (Jupiter has no devnet). The rail signs only a transaction that, simulated,
# spends no more than the amount, delivers at least the quote less the slippage
# and changes nothing else about the wallet. Use a wallet made for it. A first
# swap to Jupiter waits for the person unless the pass allows new providers (the
# 5 cent cap applies by default).
# JUPITER_SWAP_ENABLED=on
# JUPITER_API_KEY=            # from portal.jup.ag; without one the keyless tier is used
# JUPITER_MAX_SWAP_USDC=5.00  # the most one swap may spend, whatever any pass allows
# JUPITER_MAX_SLIPPAGE_BPS=100
# JUPITER_BASE_URL=https://api.jup.ag/swap/v2

# --- Not yet used in this build (documented for the providers they belong
#     to; wiring them up needs real credentials this environment does not
#     have) ---
# SPREEDLY_ENVIRONMENT_KEY=        # providers/vault SpreedlyProvider
# SPREEDLY_ACCESS_SECRET=
# ARCIUM_CLUSTER_ENDPOINT=         # providers/arcium ArciumProvider
# ARCIUM_PROGRAM_ID=
