# Copy to .env.local for local development. Never commit a real .env.local
# (already covered by .gitignore's .env*). Server-only — no NEXT_PUBLIC_
# prefix, so these never reach the browser bundle. Restart `next dev` after
# editing.

# --- Algebra REST API ---
# The browser never calls this directly: /api/v1/* is proxied to it by
# next.config.ts, and the agent's server-side tool calls use it too.
ALGEBRA_API_URL=http://localhost:8080

# --- LLM providers for the agent (lib/agent/) ---
# Set at least one. A provider with no key shows as unavailable in the
# model picker (see GET /api/agent/providers) — not a hard error.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model lists for the picker, comma-separated; the first is that
# provider's default. Defaults live in lib/agent/models.ts.
# ANTHROPIC_MODELS=claude-sonnet-5,claude-opus-5-5,claude-haiku-4-5-20251001
# OPENAI_MODELS=gpt-4o,gpt-4o-mini
# GEMINI_MODELS=gemini-flash-latest,gemini-pro-latest
