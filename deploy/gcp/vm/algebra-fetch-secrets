#!/bin/bash
# Writes the runtime environment into /run/algebra (memory only) from Secret Manager and
# Cloud KMS, using this VM's own Google identity (the metadata server). Nothing secret is
# kept on disk, in an image, or in a dashboard; a rotated secret is picked up by restarting
# the service. Run as root, before the API and the tunnel start (ExecStartPre=+).
#
# Needs: /etc/algebra/deploy.conf with PROJECT and KMS_KEY (the master key's wrapping key).
set -euo pipefail
umask 027
# shellcheck disable=SC1091
. /etc/algebra/deploy.conf

MD=http://metadata.google.internal/computeMetadata/v1
TOKEN=$(curl -fsS -H 'Metadata-Flavor: Google' "$MD/instance/service-accounts/default/token" | jq -r .access_token)

# secret NAME: the latest version's value on stdout, without line ends (a value pasted from a terminal
# or a dashboard often ends in one); fails when the secret has no version yet.
secret() {
  curl -fsS -H "Authorization: Bearer $TOKEN" \
    "https://secretmanager.googleapis.com/v1/projects/$PROJECT/secrets/$1/versions/latest:access" | jq -er .payload.data | base64 -d | tr -d '\r\n'
}

install -d -m 0750 -o root -g algebra /run/algebra

# The master key: stored wrapped by KMS; only this VM's identity can unwrap it. KMS returns the
# 32 bytes base64-encoded, which is exactly the form ALGEBRA_MASTER_KEY takes.
wrapped=$(secret algebra-master-key-wrapped)
master=$(curl -fsS -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
  -d "{\"ciphertext\":\"$wrapped\"}" "https://cloudkms.googleapis.com/v1/$KMS_KEY:decrypt" | jq -er .plaintext)

db=$(secret algebra-db-password)
redis=$(secret algebra-redis-password)
edge=$(secret algebra-edge-secret)
operator=$(secret algebra-operator-token)

tmp=$(mktemp /run/algebra/.api.env.XXXXXX)
{
  printf "ALGEBRA_MASTER_KEY='%s'\n" "$master"
  printf "DATABASE_URL='postgres://algebra:%s@127.0.0.1:5432/algebra?sslmode=require'\n" "$db"
  printf "REDIS_ADDR='redis://:%s@127.0.0.1:6379'\n" "$redis"
  printf "EDGE_SHARED_SECRET='%s'\n" "$edge"
  printf "ALGEBRA_OPERATOR_TOKEN='%s'\n" "$operator"
  # Without a Resend key the API refuses to start in production: say so in the log, not here.
  if resend=$(secret algebra-resend-api-key 2>/dev/null); then
    printf "RESEND_API_KEY='%s'\n" "$resend"
  else
    echo "algebra-fetch-secrets: algebra-resend-api-key has no value yet; the API will not start until it has" >&2
  fi
} > "$tmp"
chown root:algebra "$tmp"
chmod 0640 "$tmp"
mv -f "$tmp" /run/algebra/api.env

# The Cloudflare tunnel token, for the tunnel service (absent until the tunnel exists).
if token=$(secret algebra-cloudflare-tunnel-token 2>/dev/null); then
  tmp=$(mktemp /run/algebra/.cloudflared.env.XXXXXX)
  printf "TUNNEL_TOKEN=%s\n" "$token" > "$tmp"
  chown root:cloudflared "$tmp"
  chmod 0640 "$tmp"
  mv -f "$tmp" /run/algebra/cloudflared.env
else
  rm -f /run/algebra/cloudflared.env
  echo "algebra-fetch-secrets: algebra-cloudflare-tunnel-token has no value yet; the tunnel will not start until it has" >&2
fi
