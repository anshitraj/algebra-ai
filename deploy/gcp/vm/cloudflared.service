[Unit]
Description=Cloudflare Tunnel to the Algebra API (outbound only; no port is open on this VM)
After=network-online.target algebra-api.service
Wants=network-online.target
# The token is fetched from Secret Manager by the API's start; no token yet, no tunnel.
ConditionPathExists=/run/algebra/cloudflared.env

[Service]
User=cloudflared
Group=cloudflared
EnvironmentFile=/run/algebra/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
MemoryMax=300M

[Install]
WantedBy=multi-user.target
