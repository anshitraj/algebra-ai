# /etc/algebra/api.env  (chmod 600, owned by root; systemd reads it as root)
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080
# Debian/Ubuntu's Postgres has TLS on by default, which production mode requires.
DATABASE_URL=postgres://algebra:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/algebra?sslmode=require
REDIS_ADDR=127.0.0.1:6379
ALGEBRA_MASTER_KEY=PASTE_OUTPUT_OF__openssl_rand_-base64_32
PUBLIC_WEB_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
ENABLED_MERCHANTS=none
# One proxy (Caddy) in front of the web app, which is in front of the API.
TRUSTED_PROXY_HOPS=2
ALGEBRA_DATA_DIR=/var/lib/algebra

# Production mode refuses to start without these. Without a verified Resend
# domain, email sign-up and password reset cannot send; Privy sign-in still works.
RESEND_API_KEY=re_PASTE_YOURS
EMAIL_FROM=Algebra <no-reply@example.com>

# The operator's key (X-Algebra-Operator-Token). Without it nobody can read Book
# a Demo enquiries or verify, block or unblock a provider on this server.
# openssl rand -hex 32
ALGEBRA_OPERATOR_TOKEN=PASTE_64_HEX_CHARACTERS
# Where each new Book a Demo enquiry is emailed.
LEADS_NOTIFY_EMAIL=sales@example.com

# Sign-in with Privy (email code, Google, wallets). Add the site's origin under
# Allowed origins in the Privy dashboard.
PRIVY_APP_ID=PASTE_YOURS

# Devnet only. The payer wallet that pays providers on devnet.
SOLANA_DEVNET_KEYPAIR_FILE=/var/lib/algebra/solana-devnet.json
# "Try the demo" accounts pay simulated USDC in the sandbox.
ECONOMIC_SANDBOX=on
# Output of: /opt/algebra/bin/demo-provider -addr 127.0.0.1:8402 -print-config
ECONOMIC_PROVIDERS=PASTE_JSON_ON_ONE_LINE

# Mainnet stays off. Do not set SOLANA_MAINNET_*, SOLANA_ALLOW_MAINNET or MAINNET_EXECUTION.
