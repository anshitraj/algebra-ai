ze=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1231.0" y="1084" width="8" height="8" as="geometry"/></mxCell><mxCell id="p3c65" value="" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1771.0" y="1084" width="8" height="8" as="geometry"/></mxCell><mxCell id="p3c66" value="17 · reconciler (every 15 s): what did the attempt spend, from the chain?" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=none;verticalAlign=bottom;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3c64" target="p3c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c67" value="" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1231.0" y="1142" width="8" height="8" as="geometry"/></mxCell><mxCell id="p3c68" value="" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1501.0" y="1142" width="8" height="8" as="geometry"/></mxCell><mxCell id="p3c69" value="18 · refund(unspent, intent) → back to the vault (or the owner if closed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=none;verticalAlign=bottom;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3c67" target="p3c68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c70" value="If something goes wrong" style="swimlane;html=1;startSize=30;fontStyle=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fillColor=none;swimlaneFillColor=#121212;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1214" width="760" height="106" as="geometry"/></mxCell><mxCell id="p3c71" value="the first provider fails before money moved → the coordinator reopens the intent; the next step of the plan runs&lt;br&gt;ambiguous outcome → the intent freezes; nothing else runs until the rail proves what happened&lt;br&gt;the program refuses the pull (PassFrozen, OverBudget, …) → the attempt is denied with the program's reason&lt;br&gt;a pull's fate unknown (crash) → settled from the chain later; every state move is compare-and-set" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=left;verticalAlign=middle;spacing=6;fillColor=none;" vertex="1" parent="p3c70"><mxGeometry x="0" y="30" width="760" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 On-chain pass lifecycle" id="4-on-chain-pass-lifecycle"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" background="#121212" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4c1" value="Putting a Spend Pass on chain (console ↔ API ↔ wallet ↔ program)" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=15;align=left;verticalAlign=middle;spacing=6;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="p4c2" value="Person in the console" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="70" width="200" height="50" as="geometry"/></mxCell><mxCell id="p4c3" value="&lt;b&gt;1 · GET /api/v1/onchain/networks&lt;/b&gt;&lt;br&gt;the program, agent (payer), destination (payer's USDC account) and mint per network" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1F6FB2;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c4" value="&lt;b&gt;2 · POST /me/passes/{id}/onchain/prepare&lt;/b&gt;&lt;br&gt;unsigned tx: create_pass(id = PassNumber(spend pass), terms = the pass's limits) + deposit" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1F6FB2;rounded=1;" vertex="1" parent="1"><mxGeometry x="510" y="170" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c5" value="&lt;b&gt;3 · Owner's wallet signs and sends&lt;/b&gt;&lt;br&gt;Wallet Standard (Phantom · Solflare · Backpack), or cmd/spend-pass sign-send" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#7A3FB5;rounded=1;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c6" value="&lt;b&gt;4 · Spend Pass program&lt;/b&gt;&lt;br&gt;Pass PDA + Vault ATA created; the owner's USDC deposited" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#7A3FB5;rounded=1;" vertex="1" parent="1"><mxGeometry x="1450" y="170" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c7" value="&lt;b&gt;5 · POST /me/passes/{id}/onchain/link&lt;/b&gt;&lt;br&gt;checks on chain: agent = payer, destination = payer's USDC, owner = a sign-in wallet (mainnet) → onchain_passes" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1F6FB2;rounded=1;" vertex="1" parent="1"><mxGeometry x="1450" y="400" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c8" value="&lt;b&gt;6 · Paid requests&lt;/b&gt;&lt;br&gt;every payment is funded by a pull (page 3); GET …/onchain shows the pass, vault and recent pulls" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1F6FB2;rounded=1;" vertex="1" parent="1"><mxGeometry x="980" y="400" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c9" value="&lt;b&gt;7 · POST /me/passes/{id}/onchain/tx&lt;/b&gt;&lt;br&gt;unsigned owner tx: freeze · unfreeze · deposit · withdraw · revoke · close → the wallet signs (3)" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=11;align=center;verticalAlign=middle;spacing=6;fillColor=#1F6FB2;rounded=1;" vertex="1" parent="1"><mxGeometry x="510" y="400" width="400" height="110" as="geometry"/></mxCell><mxCell id="p4c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;" edge="1" parent="1" source="p4c2" target="p4c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c3" target="p4c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c4" target="p4c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c5" target="p4c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c6" target="p4c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c7" target="p4c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;labelBackgroundColor=#121212;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c8" target="p4c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c17" value="Configuration" style="swimlane;html=1;startSize=30;fontStyle=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fillColor=none;swimlaneFillColor=#121212;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="900" height="106" as="geometry"/></mxCell><mxCell id="p4c18" value="SPEND_PASS_PROGRAM_ID: where passes are made (empty: the program above; off: disabled)&lt;br&gt;SPEND_PASS_REQUIRED=mainnet,devnet: a pass must be on chain to pay at all (set it for mainnet)&lt;br&gt;SPEND_PASS_ANY_OWNER=devnet: the owner needn't be a sign-in wallet (demos; refused for mainnet)&lt;br&gt;SPEND_PASS_PRIORITY_MICROLAMPORTS: priority fee for pulls and refunds (default 10,000)" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=left;verticalAlign=middle;spacing=6;fillColor=none;" vertex="1" parent="p4c17"><mxGeometry x="0" y="30" width="900" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>