wner only, in any state" style="swimlane;html=1;startSize=30;fontStyle=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fillColor=none;swimlaneFillColor=#121212;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="720" width="330" height="122" as="geometry"/></mxCell><mxCell id="p1c69" value="withdraw:   vault → owner&lt;br&gt;close_pass: whole vault → owner;&lt;br&gt;            closes Pass + Vault,&lt;br&gt;            rent back to owner&lt;br&gt;revoke:     twice → AlreadyRevoked" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=left;verticalAlign=middle;spacing=6;fillColor=none;fontFamily=Courier New;" vertex="1" parent="p1c68"><mxGeometry x="0" y="30" width="330" height="92" as="geometry"/></mxCell><mxCell id="p1c70" value="pull: checks in order (else error)" style="swimlane;html=1;startSize=30;fontStyle=1;fontColor=#FFFFFF;strokeColor=#FFFFFF;fillColor=none;swimlaneFillColor=#121212;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="560" width="420" height="266" as="geometry"/></mxCell><mxCell id="p1c71" value="signer == pass.agent&lt;br&gt;destination == pass.destination&lt;br&gt;!revoked                    PassRevoked&lt;br&gt;!frozen                     PassFrozen&lt;br&gt;now &amp;lt; expires_at            PassExpired&lt;br&gt;amount &amp;gt; 0                  ZeroAmount&lt;br&gt;amount ≤ per_call_cap       OverPerCallCap&lt;br&gt;spent + amount ≤ budget     OverBudget&lt;br&gt;window_spent + amount&lt;br&gt;  ≤ window_cap (window      OverWindowCap&lt;br&gt;  resets after window_secs)&lt;br&gt;&lt;br&gt;then: spent += amount, pulls += 1,&lt;br&gt;      last_intent = intent, emit Pulled" style="whiteSpace=wrap;html=1;fontColor=#FFFFFF;strokeColor=none;fontSize=11;align=left;verticalAlign=middle;spacing=6;fillColor=none;fontFamily=Courier New;" vertex="1" parent="p1c70"><mxGeometry x="0" y="30" width="420" height="236" as="geometry"/></mxCell><mxCell id="p1c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0