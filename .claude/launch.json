{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/api"
      ],
      "port": 8080
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:HTTP_ADDR=':8090'; $env:PUBLIC_WEB_URL='http://localhost:3210'; go run ./cmd/api"
      ],
      "port": 8090
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:ALGEBRA_API_URL='http://localhost:8090'; $env:NEXT_DIST_DIR='.next-alt'; pnpm --dir web exec next dev --port 3210"
      ],
      "port": 3210
    },
    {
      "name": "mcp",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "go run ./cmd/mcp -http=:8081"
      ],
      "port": 8081
    }
  ]
}
