{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/api"
      ],
      "port": 8080
    },
    {
      "name": "api-native",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/dev-native.ps1",
        "api"
      ],
      "port": 8080
    },
    {
      "name": "api-alt",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:HTTP_ADDR=':8090'; $env:PUBLIC_WEB_URL='http://localhost:3210'; go run ./cmd/api"
      ],
      "port": 8090
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:ALGEBRA_API_URL='http://localhost:8090'; $env:NEXT_DIST_DIR='.next-alt'; pnpm --dir web exec next dev --port 3210"
      ],
      "port": 3210
    },
    {
      "name": "mcp",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "go run ./cmd/mcp -http=:8081"
      ],
      "port": 8081
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$env:ECONOMIC_PROVIDERS = (go run ./cmd/demo-provider -print-config); $env:ALGEBRA_API_ADDR = '127.0.0.1:8085'; $env:SOLANA_ALLOW_MAINNET = 'yes'; if (Test-Path .data/privy-app-id) { $env:PRIVY_APP_ID = (Get-Content .data/privy-app-id -Raw).Trim() }; if (Test-Path .data/privy-verification-key) { $env:PRIVY_VERIFICATION_KEY = Get-Content .data/privy-verification-key -Raw }; $env:PUBLIC_WEB_URL = 'http://localhost:3300'; $env:CORS_ALLOWED_ORIGINS = 'http://localhost:3300,http://localhost:3000'; & ./scripts/dev-native.ps1 api"
      ],
      "port": 8085
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:ALGEBRA_API_URL = 'http://localhost:8085'; $env:NEXT_DIST_DIR = '.next-demo'; pnpm --dir web exec next dev --port 3300"
      ],
      "port": 3300
    },
    {
      "name": "demo-provider",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/demo-provider",
        "-key",
        ".data/demo-provider.json"
      ],
      "port": 8402
    }
  ]
}
